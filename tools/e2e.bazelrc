# Shared by the e2e workspaces, each of which imports it as
# `import %workspace%/../../tools/e2e.bazelrc`. Inside an imported file,
# %workspace% is still the workspace that invoked Bazel, so the paths below
# assume the importing workspace sits two levels below the repository root.

import %workspace%/../../.aspect/bazelrc

import %workspace%/../../tools/preset.bazelrc

# Build without the bytes
common:ci --remote_download_outputs=minimal
common:ci --nobuild_runfile_links
